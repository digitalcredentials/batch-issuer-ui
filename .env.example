# Base URL of the PWS (Portable Web Spaces) server that holds the issuer's
# spaces, no trailing slash. Its Spaces Repository is {base}/spaces/.
VITE_PWS_BASE_URL=https://was.lcw-sandbox.org

# Base URL of the batch issuer API (batch-issuer-backend's HTTP API, no
# trailing slash); Notify recipients posts to {base}/notify.
# Local: sam local start-api in batch-issuer-backend, e.g. http://localhost:3013
VITE_BATCH_API_BASE=https://9r8e07254a.execute-api.us-east-1.amazonaws.com

# Base URL of the credential-templates API (no trailing slash); the template
# dropdown reads {base}/templates.
VITE_TEMPLATES_API_BASE=https://f1exkuo3g0.execute-api.us-east-1.amazonaws.com/Prod

# Base URL of the Bitstring Status List service (no trailing slash); Revoke
# posts to {base}/revoke.
VITE_STATUS_API_BASE=https://status.lcw-sandbox.org
