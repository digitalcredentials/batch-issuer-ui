# Used by `npm run build` (production mode); local development keeps using
# .env. The deployed sandbox services, each without a trailing slash.

# The PWS server that holds the issuer's spaces
VITE_PWS_BASE_URL=https://was.lcw-sandbox.org

# batch-issuer-backend's HTTP API (the BatchApi output of its stack)
VITE_BATCH_API_BASE=https://9r8e07254a.execute-api.us-east-1.amazonaws.com

# The credential-templates API
VITE_TEMPLATES_API_BASE=https://f1exkuo3g0.execute-api.us-east-1.amazonaws.com/Prod

# The Bitstring Status List service
VITE_STATUS_API_BASE=https://status.lcw-sandbox.org
