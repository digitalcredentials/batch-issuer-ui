    "@interop/http-client": "^1.0.6",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
